{
  "name": "github-actions-sdlc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A runnable SDLC and testing reference for GitHub Actions.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:entrypoint": "node --test tests/entrypoint.test.ts",
    "lint": "biome check . --error-on-warnings",
    "format": "biome check --write .",
    "check:policy": "node scripts/check-policy.ts",
    "check:links": "node scripts/check-links.ts",
    "check:dist": "npm run build && git diff --exit-code -- dist/",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:entrypoint && npm run check:policy && npm run check:links",
    "validate:workflows": "bash scripts/validate-workflows.sh"
  },
  "dependencies": {
    "@actions/core": "3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
